{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/:locale(pt-br|en|es|de|fr|ja)/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/explorar",
      "destination": "/index.html"
    },
    {
      "source": "/categoria/:id",
      "destination": "/index.html"
    },
    {
      "source": "/artigo/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/biblioteca",
      "destination": "/index.html"
    },
    {
      "source": "/favoritos",
      "destination": "/index.html"
    }
  ]
}
