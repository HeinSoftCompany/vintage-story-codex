ex":"15","fromtitle":"1.2.4/pt-br","byteoffset":4104,"anchor":"Refatoradores","linkAnchor":"Refatoradores"},{"toclevel":2,"level":"3","line":"Ajustes","number":"4.3","index":"16","fromtitle":"1.2.4/pt-br","byteoffset":4405,"anchor":"Ajustes_2","linkAnchor":"Ajustes_2"},{"toclevel":1,"level":"2","line":"Referências","number":"5","index":"17","fromtitle":"1.2.4/pt-br","byteoffset":4572,"anchor":"Referências","linkAnchor":"Referências"}],"revid":372794,"sourceUrl":"https://wiki.vintagestory.at/index.php?title=1.2.4%2Fpt-br","capturedAt":"2026-11-11T11:55:39.218Z"}