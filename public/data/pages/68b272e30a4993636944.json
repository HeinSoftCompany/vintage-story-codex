/60px-Trader-waypoint.png 1.5x, /images/thumb/7/7f/Trader-waypoint.png/80px-Trader-waypoint.png 2x\" data-file-width=\"264\" data-file-height=\"256\" /></a></span></td>\n<td>Comerciante\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Vessel-waypoint.png\" class=\"mw-file-description\"><img src=\"/images/thumb/0/00/Vessel-waypoint.png/40px-Vessel-waypoint.png\" decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"42\" class=\"mw-file-element\" srcset=\"/images/thumb/0/00/Vessel-waypoint.png/60px-Vessel-waypoint.png 1.5x, /images/thumb/0/00/Vessel-waypoint.png/80px-Vessel-waypoint.png 2x\" data-file-width=\"269\" data-file-height=\"282\" /></a></span></td>\n<td>Vessel\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Turnip-waypoint.png\" class=\"mw-file-description\"><img src=\"/images/thumb/2/2a/Turnip-waypoint.png/40px-Turnip-waypoint.png\" decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element\" srcset=\"/images/thumb/2/2a/Turnip-waypoint.png/60px-Turnip-waypoint.png 1.5x, /images/thumb/2/2a/Turnip-waypoint.png/80px-Turnip-waypoint.png 2x\" data-file-width=\"150\" data-file-height=\"150\" /></a></span></td>\n<td>Turnip\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Grains-waypoint.png\" class=\"mw-file-description\"><img src=\"/images/thumb/3/3c/Grains-waypoint.png/40px-Grains-waypoint.png\" decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element\" srcset=\"/images/thumb/3/3c/Grains-waypoint.png/60px-Grains-waypoint.png 1.5x, /images/thumb/3/3c/Grains-waypoint.png/80px-Grains-waypoint.png 2x\" data-file-width=\"150\" data-file-height=\"150\" /></a></span></td>\n<td>Grain\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Apple-waypoint.png\" class=\"mw-file-description\"><img src=\"/images/thumb/5/56/Apple-waypoint.png/40px-Apple-waypoint.png\" decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"40\" class=\"mw-file-element\" srcset