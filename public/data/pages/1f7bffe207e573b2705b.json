{"title":"Pumpkin","sourceTitle":"Pumpkin/pt-br","html":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"pt-BR\" dir=\"ltr\"><div class=\"mw-pt-languages noprint navigation-not-searchable\" lang=\"en\" dir=\"ltr\"><div class=\"mw-pt-languages-label\">Other languages:</div><ul class=\"mw-pt-languages-list\"><li><a href=\"/Pumpkin\" class=\"mw-pt-languages-ui mw-pt-progress mw-pt-progress--complete\" title=\"Pumpkin (100% translated)\" lang=\"en\" dir=\"ltr\">English</a></li>\n<li><a href=\"/Pumpkin/es\" class=\"mw-pt-progress mw-pt-progress--med\" title=\"Calabaza (38% translated)\" lang=\"es\" dir=\"ltr\">español</a></li>\n<li><a href=\"/Pumpkin/fr\" class=\"mw-pt-progress mw-pt-progress--med\" title=\"Citrouille (65% translated)\" lang=\"fr\" dir=\"ltr\">français</a></li>\n<li><a href=\"/Pumpkin/it\" class=\"mw-pt-progress mw-pt-progress--low\" title=\"Zucca (3% translated)\" lang=\"it\" dir=\"ltr\">italiano</a></li>\n<li><span class=\"mw-pt-languages-selected mw-pt-progress mw-pt-progress--high\" lang=\"pt-BR\" dir=\"ltr\">português do Brasil</span></li>\n<li><a href=\"/Pumpkin/ru\" class=\"mw-pt-progress mw-pt-progress--med\" title=\"Тыква (65% translated)\" lang=\"ru\" dir=\"ltr\">русский</a></li>\n<li><a href=\"/Pumpkin/uk\" class=\"mw-pt-progress mw-pt-progress--med\" title=\"Гарбуз (65% translated)\" lang=\"uk\" dir=\"ltr\">українська</a></li>\n<li><a href=\"/Pumpkin/zh\" class=\"mw-pt-progress mw-pt-progress--complete\" title=\"南瓜 (100% translated)\" lang=\"zh\" dir=\"ltr\">中文</a></li></ul></div><p><br />\n</p><div style=\"float:right;\">\n<table border=\"1\" cellpadding=\"2\" cellspacing=\"0\" style=\"position:relative; border-radius:7px; font-size:90%; width:300px; float:right; margin-left:5px; margin-bottom: 5px;\">\n\n<tbody><tr>\n<td bgcolor=\"#000000\" colspan=\"2\" style=\"border-top-right-radius:7px; border-top-left-radius:7px; text-align:center; font-size:13.5px;\"><font color=\"white\"><b>Fatia de abóbora</b></font>\n</td></tr>\n<tr>\n<td bgcolor=\"#d3ab92\" colspan=\"2\" style=\"text-align: center\"><span typeof=\"mw:File\"><a href=\"/File:Pumpkin_slices.png\" class=\"mw-file-description\"><img src=\"/images/thumb/a/a5/Pumpkin_slices.png/100px-Pumpkin_slices.png\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element\" srcset=\"/images/thumb/a/a5/Pumpkin_slices.png/150px-Pumpkin_slices.png 1.5x, /images/thumb/a/a5/Pumpkin_slices.png/200px-Pumpkin_slices.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span>\n</td></tr>\n<tr>\n<td><b>Empilhável</b>\n</td>\n<td>64\n</td></tr>\n\n<tr>\n<td bgcolor=\"#000000\" colspan=\"2\" style=\"text-align:center; font-size:13.5px;\"><font color=\"white\"><b>Comida</b></font>\n</td></tr>\n<tr>\n<td><b>Saciedade</b>\n</td>\n<td>140\n</td></tr>\n<tr>\n<td><b>Categoria</b>\n</td>\n<td>\n<p>Legume\n</p>\n</td></tr>\n<tr>\n<td bgcolor=\"#000000\" colspan=\"2\" style=\"text-align:center; font-size:13.5px;\"><font color=\"white\"><b>Transitável</b></font>\n</td></tr>\n<tr>\n<td><b>Tempo fresco</b>\n</td>\n<td>9 dias\n</td></tr>\n<tr>\n<td><b><a href=\"/Special:MyLanguage/Rot#Notes\" title=\"Special:MyLanguage/Rot\">Tempo de apodrecimento</a></b>\n</td>\n<td>3 dias\n</td></tr>\n<tr>\n<td><b><a href=\"/Special:MyLanguage/Rot#Notes\" title=\"Special:MyLanguage/Rot\">Taxa de apodrecimento</a></b>\n</td>\n<td>0.56\n</td></tr>\n\n<tr>\n<td bgcolor=\"#000000\" colspan=\"2\" class=\"Bloba\" style=\"text-align:center; font-size:13.5px; border-bottom-right-radius:7px; border-bottom-left-radius:7px;\"><a href=\"/Items\" class=\"mw-redirect\" title=\"Items\"><font color=\"white\"><b>Itens</b></font></a>\n</td></tr></tbody></table>\n</div>\n<div style=\"float:right;\">\n<table border=\"1\" cellpadding=\"2\" cellspacing=\"0\" style=\"position:relative; border-radius:7px; font-size:90%; width:300px; float:right; margin-left:5px; margin-bottom: 5px;\">\n\n<tbody><tr>\n<td bgcolor=\"#000000\" colspan=\"2\" style=\"border-top-right-radius:7px; border-top-left-radius:7px; text-align:center; font-size:13.5px;\"><font color=\"white\"><b>Abóbora</b></font>\n</td></tr>\n<tr>\n<td bgcolor=\"#d3ab92\" colspan=\"2\" style=\"text-align: center\"><span typeof=\"mw:File\"><a href=\"/File:Pumpkin-fruit-4.png\" class=\"mw-file-description\"><img src=\"/images/thumb/2/22/Pumpkin-fruit-4.png/100px-Pumpkin-fruit-4.png\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"100\" class=\"mw-file-element\" srcset=\"/images/thumb/2/22/Pumpkin-fruit-4.png/150px-Pumpkin-fruit-4.png 1.5x, /images/thumb/2/22/Pumpkin-fruit-4.png/200px-Pumpkin-fruit-4.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span>\n</td></tr>\n<tr>\n<td><b>Material</b>\n</td>\n<td>Plant\n</td></tr>\n<tr>\n<td><b>Empilhável</b>\n</td>\n<td>8\n</td></tr>\n\n<tr>\n<td bgcolor=\"#000000\" colspan=\"2\" style=\"text-align:center; font-size:13.5px;\"><font color=\"white\"><b>Transitável</b></font>\n</td></tr>\n<tr>\n<td><b>Tempo fresco</b>\n</td>\n<td>18 dias\n</td></tr>\n<tr>\n<td><b><a href=\"/Special:MyLanguage/Rot#Notes\" title=\"Special:MyLanguage/Rot\">Tempo de apodrecimento</a></b>\n</td>\n<td>5.8 dias\n</td></tr>\n<tr>\n<td><b><a href=\"/Special:MyLanguage/Rot#Notes\" title=\"Special:MyLanguage/Rot\">Taxa de apodrecimento</a></b>\n</td>\n<td>2\n</td></tr>\n\n<tr>\n<td bgcolor=\"#000000\" colspan=\"2\" class=\"Bloba\" style=\"text-align:center; font-size:13.5px; border-bottom-right-radius:7px; border-bottom-left-radius:7px;\"><a href=\"/Items\" class=\"mw-redirect\" title=\"Items\"><font color=\"white\"><b>Itens</b></font></a>\n</td></tr></tbody></table>\n</div>\n<figure class=\"mw-default-size\" typeof=\"mw:File/Thumb\"><a href=\"/File:Pumpkin_farm.png\" class=\"mw-file-description\"><img src=\"/images/thumb/9/97/Pumpkin_farm.png/300px-Pumpkin_farm.png\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"176\" class=\"mw-file-element\" srcset=\"/images/thumb/9/97/Pumpkin_farm.png/450px-Pumpkin_farm.png 1.5x, /images/thumb/9/97/Pumpkin_farm.png/600px-Pumpkin_farm.png 2x\" data-file-width=\"1444\" data-file-height=\"848\" /></a><figcaption></figcaption></figure>\n<p><b>Abóboras</b> são uma fonte de alimento. Eles têm comportamentos de crescimento muito diferentes de outras culturas e precisam de <i>muito</i> mais espaço para cultivar de forma sustentável.\n</p><p><span id=\"Obtaining\"></span>\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Obtendo\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Obtendo</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Cultivo\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Cultivo</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-3\"><a href=\"#Planta_mãe_de_abóbora\"><span class=\"tocnumber\">2.1</span> <span class=\"toctext\">Planta mãe de abóbora</span></a></li>\n<li class=\"toclevel-2 tocsection-4\"><a href=\"#Comportamento_da_videira\"><span class=\"tocnumber\">2.2</span> <span class=\"toctext\">Comportamento da videira</span></a></li>\n<li class=\"toclevel-2 tocsection-5\"><a href=\"#Diretrizes_de_plantio\"><span class=\"tocnumber\">2.3</span> <span class=\"toctext\">Diretrizes de plantio</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-6\"><a href=\"#Uso\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Uso</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-7\"><a href=\"#Comida\"><span class=\"tocnumber\">3.1</span> <span class=\"toctext\">Comida</span></a></li>\n<li class=\"toclevel-2 tocsection-8\"><a href=\"#Criação_de_animais\"><span class=\"tocnumber\">3.2</span> <span class=\"toctext\">Criação de animais</span></a></li>\n<li class=\"toclevel-2 tocsection-9\"><a href=\"#Escultura\"><span class=\"tocnumber\">3.3</span> <span class=\"toctext\">Escultura</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-10\"><a href=\"#Histórico\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Histórico</span></a></li>\n<li class=\"toclevel-1 tocsection-11\"><a href=\"#Observações\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Observações</span></a></li>\n<li class=\"toclevel-1 tocsection-12\"><a href=\"#Galeria\"><span class=\"tocnumber\">6</span> <span class=\"toctext\">Galeria</span></a></li>\n<li class=\"toclevel-1 tocsection-13\"><a href=\"#Veja_também\"><span class=\"tocnumber\">7</span> <span class=\"toctext\">Veja também</span></a></li>\n<li class=\"toclevel-1 tocsection-14\"><a href=\"#Referências\"><span class=\"tocnumber\">8</span> <span class=\"toctext\">Referências</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Obtendo\">Obtendo</span></h2>\n<div class=\"mw-translate-fuzzy\">\n<p>Abóboras não são encontradas como <a href=\"/Special:MyLanguage/Wild_Foods\" title=\"Special:MyLanguage/Wild Foods\">colheitas selvagens</a><span style=\"display:none\"><a href=\"/Wild_Foods\" class=\"mw-redirect\" title=\"Wild Foods\"> </a></span>. Em vez disso, as sementes raramente são encontradas dentro de <a href=\"/Special:MyLanguage/Loot_Vessels\" title=\"Special:MyLanguage/Loot Vessels\">navios de saque</a><span style=\"display:none\"><a href=\"/Loot_Vessels\" class=\"mw-redirect\" title=\"Loot Vessels\"> </a></span>.\n</p>\n</div>\n<p>Depois de plantar e colher abóboras com sucesso, as sementes podem ser criadas a partir dos frutos inteiros da abóbora, simplesmente colocando-as na grau de artesanato. Uma abóbora cheia só se transformará em uma semente, portanto, é necessário planejamento para garantir que haja abóboras suficientes cultivadas para replantar a colheita.\n</p><p>Em servidores multijogador, pode ser mais fácil negociar sementes com jogadores estabelecidos do que tentar encontrar as suas próprias.\n</p><p><span id=\"Cultivation\"></span>\n</p>\n<h2><span class=\"mw-headline\" id=\"Cultivo\">Cultivo</span></h2>\n<figure typeof=\"mw:File/Thumb\"><a href=\"/File:Pumpkin-fully-grown-crop.png\" class=\"mw-file-description\"><img src=\"/images/thumb/0/0f/Pumpkin-fully-grown-crop.png/300px-Pumpkin-fully-grown-crop.png\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"144\" class=\"mw-file-element\" srcset=\"/images/thumb/0/0f/Pumpkin-fully-grown-crop.png/450px-Pumpkin-fully-grown-crop.png 1.5x, /images/thumb/0/0f/Pumpkin-fully-grown-crop.png/600px-Pumpkin-fully-grown-crop.png 2x\" data-file-width=\"971\" data-file-height=\"465\" /></a><figcaption>Abóboras maduras</figcaption></figure>\n<p>As abóboras passam por 8 estágios de crescimento ao longo de 2,27 meses (20,4 dias), nas configurações padrão de 9 dias por mês. Eles usam até 30% dos nutrientes P do seu bloco agrícola. Ao contrário de outras culturas, que crescem apenas no bloco onde são plantadas, as abóboras espalham-se como vinhas a partir de uma planta-mãe central. As abóboras maduras crescem nas vinhas geradas pela planta-mãe.\n</p><p><span id=\"Pumpkin&#95;Mother&#95;Plant\"></span>\n</p>\n<h3><span id=\"Planta_m.C3.A3e_de_ab.C3.B3bora\"></span><span class=\"mw-headline\" id=\"Planta_mãe_de_abóbora\">Planta mãe de abóbora</span></h3>\n<p>As abóboras consistem em três componentes principais: a planta-mãe, as vinhas e o fruto. A planta mãe segue o comportamento de crescimento definido nas propriedades da cultura e se comporta da mesma forma que outras culturas. Porém, uma vez que a planta atinja o estágio 3 ou superior, ela tem 50% de chance de gerar uma videira de estágio 1 em qualquer um dos 4 lados adjacentes, desde que a posição seja ocupada por ar ou um bloco com substituível &gt;= 6000 e que o bloco de suporte (embaixo) seja sólido. Após 6 dias de jogo, ele não gerará mais vinhas.\n</p><p><span id=\"Vine&#95;behavior\"></span>\n</p>\n<h3><span class=\"mw-headline\" id=\"Comportamento_da_videira\">Comportamento da videira</span></h3>\n<p>Uma videira avançará 1 estágio a cada 12 horas de jogo. Durante o estágio 2, há uma alteração de 50% para gerar outra videira do estágio 1. A videira tem 75% de chance de desovar na direção oposta do pai e 25% de desovar à esquerda ou direita. Seis horas de jogo após atingir o estágio 3, esta nova videira tem 50% de chance de se tornar uma videira do estágio 3 de floração.\n</p>\n<ul><li>No início e no final de cada intervalo de tempo, uma videira no estágio de floração 3 possui:\n<ul><li>50% de chance de gerar uma abóbora em qualquer um dos 4 lados adjacentes (se for gratuito)</li>\n<li>50% de chance de reverter para uma videira normal de estágio 3</li>\n<li>Após 3 intervalos de tempo, ele voltará a ser uma videira normal de estágio 3</li></ul></li></ul>\n<p><span id=\"Planting&#95;guidelines\"></span>\n</p>\n<h3><span class=\"mw-headline\" id=\"Diretrizes_de_plantio\">Diretrizes de plantio</span></h3>\n<p>As vinhas raramente se espalham além de 4 quarteirões de distância da planta-mãe. As vinhas mais longas crescem diretamente da abóbora; portanto, se plantar sementes em linha reta, deixe pelo menos 8 blocos entre as plantas-mãe. As plantas produzirão cerca de 2,6 abóboras em média.\n</p><p>Ocasionalmente, um jogador pode descobrir que as vinhas se espalharam significativamente. Em pelo menos um caso, uma videira tinha 7 seções em uma única direção. Em outro caso, uma videira tinha 10 seções, mas elas não estavam em linha reta.\n</p><p><span id=\"Usage\"></span>\n</p>\n<h2><span class=\"mw-headline\" id=\"Uso\">Uso</span></h2>\n<h3><span class=\"mw-headline\" id=\"Comida\">Comida</span></h3>\n<div class=\"center\" style=\"background-color: #eee; border-style: solid; border-width: 1px 1px 1px 4px; border-color: #88acf5; border-radius: 4px; font-size: 75%; width: 50em; padding: 0.2em; margin: 0.5em auto; margin-left:0px;\"><div style=\"display: flex; justify-content: flex-start; align-items: center; padding-left: 10px\">\n<div style=\"margin-left: 10px; text-align: left;\">\n<p>Esta seção foi verificada pela última vez para a versão do Vintage Story <b>1.19.0 </b>.\n</p>\n</div></div></div>\n<p><br />\nAs abóboras não podem ser comidas inteiras nem usadas para <a href=\"/Special:MyLanguage/cooking\" title=\"Special:MyLanguage/cooking\">cozimento</a><span style=\"display:none\"><a href=\"/Cooking\" title=\"Cooking\"> </a></span>.\n</p><p>Em vez disso, as abóboras devem ser criadas com uma faca na grau de artesanato para produzir 4 fatias de abóbora, restaurando 140 vegetais <a href=\"/Special:MyLanguage/satiety\" title=\"Special:MyLanguage/satiety\">saciedade</a><span style=\"display:none\"><a href=\"/Satiety\" title=\"Satiety\"> </a></span> cada. As fatias de abóbora podem ser utilizadas na culinária, onde são qualificadas como vegetais e, portanto, como ingrediente principal para ensopados de vegetais, ou como ingrediente secundário em ensopados de carne, sopas e mingaus.\n</p><p>As abóboras, inteiras ou fatiadas, beneficiam do armazenamento num <a href=\"/Special:MyLanguage/Room#Cellar\" title=\"Special:MyLanguage/Room\">despensa</a><span style=\"display:none\"><a href=\"/Room#Cellar\" title=\"Room\"> </a></span>. Fatias de abóbora podem ser <a href=\"/Special:MyLanguage/Food_preservation\" title=\"Special:MyLanguage/Food preservation\">em conserva</a><span style=\"display:none\"><a href=\"/Food_preservation\" title=\"Food preservation\"> </a></span> para prolongar ainda mais sua vida útil, embora ao custo de reduzir sua saciedade fornecida de 140 para 80.\n</p><p><span id=\"Animal&#95;Husbandry\"></span>\n</p>\n<h3><span id=\"Cria.C3.A7.C3.A3o_de_animais\"></span><span class=\"mw-headline\" id=\"Criação_de_animais\">Criação de animais</span></h3>\n<h3><span class=\"mw-headline\" id=\"Escultura\">Escultura</span></h3>\n<p>Durante o mês de outubro (na vida real, não no jogo), o brilho criativo é adicionado automaticamente como material secundário para permitir aos jogadores fazer lanternas de abóbora. Esta é a única fonte de brilho criativo acessível no vanilla sem comandos de console.\n</p><p><span id=\"History\"></span>\n</p>\n<h2><span id=\"Hist.C3.B3rico\"></span><span class=\"mw-headline\" id=\"Histórico\">Histórico</span></h2>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.vintagestory.at/forums/topic/212-the-mega-survial-update-v142\">Versão 1.4.2</a> adicionou abóboras. \"Comportamento de cultivo personalizado e realista, diferente de outras culturas. Achado raro em recipientes de sementes encontrados em ruínas.\"</li></ul>\n<ul><li><a rel=\"nofollow\" class=\"external text\" href=\"https://www.vintagestory.at/forums/topic/11834-v1190-dejank-redux-stable/\">Versão 1.19.0</a> \"Ajuste: As abóboras não podem mais ser comidas inteiras, mas devem ser cortadas em pedaços para comer (como abacaxi)\"</li></ul>\n<p><span id=\"Notes\"></span>\n</p>\n<h2><span id=\"Observa.C3.A7.C3.B5es\"></span><span class=\"mw-headline\" id=\"Observações\">Observações</span></h2>\n<p><span id=\"Gallery\"></span>\n</p>\n<h2><span class=\"mw-headline\" id=\"Galeria\">Galeria</span></h2>\n<p><span id=\"See&#95;also\"></span>\n</p>\n<h2><span id=\"Veja_tamb.C3.A9m\"></span><span class=\"mw-headline\" id=\"Veja_também\">Veja também</span></h2>\n<p><span id=\"References\"></span>\n</p>\n<h2><span id=\"Refer.C3.AAncias\"></span><span class=\"mw-headline\" id=\"Referências\">Referências</span></h2>\n<p><br style=\"clear:both\" />\n</p>\n<div style=\"margin: auto; padding: 4px; border-color: #382b1e; border-width: 3px; border-style: solid; margin: auto; width: 90%; border-radius: 4px; background-color: #e0cfbb;\">\n<table class=\"mw-collapsible mw-collapsed\" style=\"border-spacing: 2px; width: 100%;\">\n  <tbody><tr><th colspan=\"2\" style=\"background: rgb(91,76,62); background: linear-gradient(to bottom, rgba(91,76,62,1) 0px, rgba(91,76,62,0) 5px, rgba(56,43,30,0) calc(100% - 5px), rgba(56,43,30,1) 100%), linear-gradient(to right, rgba(91,76,62,1) 0px, rgba(69,52,36,1) 5px, rgba(69,52,36,1) 50%, rgba(69,52,36,1) calc(100% - 5px), rgba(56,43,30,1) 100%);\">\n    <big><b><span style=\"color: #e0cfbb\"><a href=\"/Farming/pt-br\" title=\"Farming/pt-br\"><span style=\"color: #e0cfbb\">Agricultura</span></a><span style=\"display:none\"><a href=\"/Farming/pt-br\" title=\"Farming/pt-br\"> </a></span></span></b></big></th>\n  </tr>\n  <tr>\n    <td style=\"height: 30px; text-align: center; width: 10%; background: #5B4C3E; color:#e0cfbb;\"><b><a href=\"/Wild_food/pt-br\" title=\"Wild food/pt-br\"><span style=\"color: #e0cfbb\">Alimentos selvagens</span></a><span style=\"display:none\"><a href=\"/Wild_food/pt-br\" title=\"Wild food/pt-br\"> </a></span></b></td>\n    <td style=\"background: #e0cfbb;\"><a href=\"/Berry/pt-br\" title=\"Berry/pt-br\">Frutos silvestres</a><span style=\"display:none\"><a href=\"/Berry/pt-br\" title=\"Berry/pt-br\"> </a></span> • <a href=\"/Wild_food/pt-br\" title=\"Wild food/pt-br\">Fruta de cacto (saguaro)</a><span style=\"display:none\"><a href=\"/Wild_food/pt-br\" title=\"Wild food/pt-br\"> </a></span> • <a href=\"/Mushroom/pt-br\" title=\"Mushroom/pt-br\">Cogumelos</a><span style=\"display:none\"><a href=\"/Mushroom/pt-br\" title=\"Mushroom/pt-br\"> </a></span> • <a href=\"/Reed/pt-br\" title=\"Reed/pt-br\">Taboa</a><span style=\"display:none\"><a href=\"/Reed/pt-br\" title=\"Reed/pt-br\"> </a></span> (e papiro)</td>\n  </tr>\n<tr>\n    <td style=\"height: 30px; text-align: center; width: 10%; background: #5B4C3E; color:#e0cfbb;\"><b><a href=\"/Grain/pt-br\" title=\"Grain/pt-br\"><span style=\"color: #e0cfbb\">Grãos</span></a><span style=\"display:none\"><a href=\"/Grain/pt-br\" title=\"Grain/pt-br\"> </a></span></b></td>\n    <td style=\"background: #CCBCAB;\">Amaranto • <a href=\"/Cassava/pt-br\" title=\"Cassava/pt-br\">Mandioca</a><span style=\"d