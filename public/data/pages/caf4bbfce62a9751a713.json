":1,"level":"2","line":"Curiosidades","number":"5","index":"14","fromtitle":"1.3.4/pt-br","byteoffset":3191,"anchor":"Curiosidades","linkAnchor":"Curiosidades"},{"toclevel":1,"level":"2","line":"Referências","number":"6","index":"15","fromtitle":"1.3.4/pt-br","byteoffset":3467,"anchor":"Referências","linkAnchor":"Referências"}],"revid":372908,"sourceUrl":"https://wiki.vintagestory.at/index.php?title=1.3.4%2Fpt-br","capturedAt":"2026-11-11T11:55:54.072Z"}