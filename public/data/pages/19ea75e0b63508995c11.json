{"title":"Hare","sourceTitle":"Hare/pt-br","html":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"pt-BR\" dir=\"ltr\"><div class=\"mw-pt-languages noprint navigation-not-searchable\" lang=\"en\" dir=\"ltr\"><div class=\"mw-pt-languages-label\">Other languages:</div><ul class=\"mw-pt-languages-list\"><li><a href=\"/Hare\" class=\"mw-pt-languages-ui mw-pt-progress mw-pt-progress--complete\" title=\"Hare (100% translated)\" lang=\"en\" dir=\"ltr\">English</a></li>\n<li><a href=\"/Hare/es\" class=\"mw-pt-progress mw-pt-progress--med\" title=\"Liebre (62% translated)\" lang=\"es\" dir=\"ltr\">español</a></li>\n<li><a href=\"/Hare/fr\" class=\"mw-pt-progress mw-pt-progress--med\" title=\"Lièvre (64% translated)\" lang=\"fr\" dir=\"ltr\">français</a></li>\n<li><span class=\"mw-pt-languages-selected mw-pt-progress mw-pt-progress--complete\" lang=\"pt-BR\" dir=\"ltr\">português do Brasil</span></li>\n<li><a href=\"/Hare/ru\" class=\"mw-pt-progress mw-pt-progress--med\" title=\"Заяц (64% translated)\" lang=\"ru\" dir=\"ltr\">русский</a></li>\n<li><a href=\"/Hare/zh\" class=\"mw-pt-progress mw-pt-progress--complete\" title=\"野兔 (100% translated)\" lang=\"zh\" dir=\"ltr\">中文</a></li></ul></div>\n<p><br />\n</p>\n<table border=\"1\" cellpadding=\"2\" cellspacing=\"0\" class=\"screwTemplatesMan\" style=\"position:relative; border-radius:7px; font-size:90%; width:250px; float:right; margin-left:15px; margin-bottom: 5px;\">\n\n<tbody><tr>\n<td bgcolor=\"#5E462A\" colspan=\"2\" style=\"border-top-right-radius:7px; border-top-left-radius:7px; text-align:center; font-size:13.5px;\"><font color=\"#EAD3B3\"><b>Lebres</b></font>\n</td></tr>\n<tr>\n<td bgcolor=\"#D1B296\" colspan=\"2\" style=\"text-align: center\"><div class=\"tabber tabber--init\"><header class=\"tabber__header\"><button class=\"tabber__header__prev\" tabindex=\"-1\" type=\"button\" aria-hidden=\"true\"></button><nav class=\"tabber__tabs\" role=\"tablist\"><a class=\"tabber__tab\" role=\"tab\" id=\"tabber-Macho-label\" href=\"#tabber-Macho\" aria-controls=\"tabber-Macho\">Macho</a><a class=\"tabber__tab\" role=\"tab\" id=\"tabber-Fêmea-label\" href=\"#tabber-Fêmea\" aria-controls=\"tabber-Fêmea\">Fêmea</a><a class=\"tabber__tab\" role=\"tab\" id=\"tabber-Bebê-label\" href=\"#tabber-Bebê\" aria-controls=\"tabber-Bebê\">Bebê</a></nav><button class=\"tabber__header__next\" tabindex=\"-1\" type=\"button\" aria-hidden=\"true\"></button></header><section class=\"tabber__section\"><article class=\"tabber__panel\" role=\"tabpanel\" tabindex=\"0\" id=\"tabber-Macho\" aria-labelledby=\"tabber-Macho-label\"><p class=\"mw-empty-elt\">\n</p><figure class=\"mw-halign-center\" typeof=\"mw:File\"><a href=\"/File:Creature-hares-male.gif\" class=\"mw-file-description\"><img src=\"/images/thumb/c/ca/Creature-hares-male.gif/130px-Creature-hares-male.gif\" decoding=\"async\" loading=\"lazy\" width=\"130\" height=\"130\" class=\"mw-file-element\" srcset=\"/images/thumb/c/ca/Creature-hares-male.gif/195px-Creature-hares-male.gif 1.5x, /images/thumb/c/ca/Creature-hares-male.gif/260px-Creature-hares-male.gif 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a><figcaption></figcaption></figure>\n<p class=\"mw-empty-elt\"></p></article><article class=\"tabber__panel\" role=\"tabpanel\" tabindex=\"0\" id=\"tabber-Fêmea\" aria-labelledby=\"tabber-Fêmea-label\"><p class=\"mw-empty-elt\">\n</p><figure class=\"mw-halign-center\" typeof=\"mw:File\"><a href=\"/File:Creature-hares-female.gif\" class=\"mw-file-description\"><img src=\"/images/thumb/1/1f/Creature-hares-female.gif/130px-Creature-hares-female.gif\" decoding=\"async\" loading=\"lazy\" width=\"130\" height=\"130\" class=\"mw-file-element\" srcset=\"/images/thumb/1/1f/Creature-hares-female.gif/195px-Creature-hares-female.gif 1.5x, /images/thumb/1/1f/Creature-hares-female.gif/260px-Creature-hares-female.gif 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a><figcaption></figcaption></figure>\n<p class=\"mw-empty-elt\"></p></article><article class=\"tabber__panel\" role=\"tabpanel\" tabindex=\"0\" id=\"tabber-Bebê\" aria-labelledby=\"tabber-Bebê-label\"><p class=\"mw-empty-elt\">\n</p><figure class=\"mw-halign-center\" typeof=\"mw:File\"><a href=\"/File:Hare-baby.png\" class=\"mw-file-description\"><img src=\"/images/thumb/e/e2/Hare-baby.png/130px-Hare-baby.png\" decoding=\"async\" loading=\"lazy\" width=\"130\" height=\"130\" class=\"mw-file-element\" srcset=\"/images/thumb/e/e2/Hare-baby.png/195px-Hare-baby.png 1.5x, /images/thumb/e/e2/Hare-baby.png/260px-Hare-baby.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a><figcaption></figcaption></figure>\n<p class=\"mw-empty-elt\"></p></article></section></div>\n</td></tr>\n<tr>\n<td bgcolor=\"#5E462A\" colspan=\"2\" style=\"text-align:center; font-size:13.5px;\"><font color=\"#EAD3B3\"><b>Saúde</b></font>\n</td></tr>\n\n\n\n\n<tr>\n<td><b>Saúde (Macho/Fêmea)</b>\n</td>\n<td>5\n</td></tr>\n<tr>\n<td><b>Saúde (Bebê)</b>\n</td>\n<td>3\n</td></tr>\n<tr>\n<td bgcolor=\"#5E462A\" colspan=\"2\" style=\"text-align:center; font-size:13.5px;\"><font color=\"#EAD3B3\"><b>Ataque</b></font>\n</td></tr>\n\n\n\n\n<tr>\n<td><b>Ataque Base (Macho/Fêmea)</b>\n</td>\n<td>0\n</td></tr>\n\n\n<tr>\n<td><b>Ataque Base (Bebê)</b>\n</td>\n<td>0\n</td></tr>\n<tr>\n<td bgcolor=\"#5E462A\" colspan=\"2\" style=\"text-align:center; font-size:13.5px;\"><font color=\"#EAD3B3\"><b>Comportamento</b></font>\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<td bgcolor=\"#5E462A\" colspan=\"2\" style=\"text-align:center; font-size:13.5px;\"><font color=\"#EAD3B3\"><b> Multiplicar</b></font>\n</td></tr>\n<tr>\n<td><b>Saciedade para Mate (porções)</b>\n</td>\n<td>2\n</td></tr>\n<tr>\n<td><b>Tempo de gestação (dias)</b>\n</td>\n<td>5\n</td></tr>\n\n\n<tr>\n<td><b>Tempo de crescimento (dias)</b>\n</td>\n<td>14\n</td></tr>\n<tr>\n<td bgcolor=\"#000000\" colspan=\"2\" style=\"text-align:center; font-size:13.5px;\"><font color=\"white\"><b>Gotas</b></font>\n</td></tr>\n<tr>\n<td><b><a href=\"/Special:MyLanguage/Redmeat\" title=\"Special:MyLanguage/Redmeat\">carne vermelha</a><span style=\"display:none\"><a href=\"/Redmeat\" class=\"mw-redirect\" title=\"Redmeat\"> </a></span></b>\n</td>\n<td>2<abbr title=\"2,5 significa 2 + 50% de chance\">*</abbr>\n</td></tr>\n<tr>\n<td><b><a href=\"/Special:MyLanguage/Raw_hide\" title=\"Special:MyLanguage/Raw hide\">Pele crua pequena</a><span style=\"display:none\"><a href=\"/Raw_hide\" class=\"mw-redirect\" title=\"Raw hide\"> </a></span></b>\n</td>\n<td>0.5<abbr title=\"2,5 significa 2 + 50% de chance\">*</abbr>\n</td></tr>\n<tr>\n<td bgcolor=\"#5E462A\" colspan=\"2\" class=\"Bloba\" style=\"text-align:center; font-size:13.5px; border-bottom-right-radius:7px; border-bottom-left-radius:7px;\"><a href=\"/Animals\" class=\"mw-redirect\" title=\"Animals\"><font color=\"white\"><b>Animais</b></font></a>\n</td></tr></tbody></table>\n<p><br />\n</p><p><b>Lebres</b> são um dos animais comuns encontrados no mundo e são uma fonte de <a href=\"/Special:MyLanguage/Redmeat\" title=\"Special:MyLanguage/Redmeat\">carne vermelha</a><span style=\"display:none\"><a href=\"/Redmeat\" class=\"mw-redirect\" title=\"Redmeat\"> </a></span> e <a href=\"/Special:MyLanguage/Hide\" title=\"Special:MyLanguage/Hide\">pequenas peles cruas</a><span style=\"display:none\"><a href=\"/Hide\" title=\"Hide\"> </a></span>.\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Desova\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Desova</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Comportamento\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Comportamento</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Domesticação_e_Reprodução\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Domesticação e Reprodução</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-4\"><a href=\"#Comida\"><span class=\"tocnumber\">3.1</span> <span class=\"toctext\">Comida</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Itens_obtidos\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Itens obtidos</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-6\"><a href=\"#Gotas_de_lebre_adulta\"><span class=\"tocnumber\">4.1</span> <span class=\"toctext\">Gotas de lebre adulta</span></a></li>\n<li class=\"toclevel-2 tocsection-7\"><a href=\"#Gotas_de_lebre_bebê\"><span class=\"tocnumber\">4.2</span> <span class=\"toctext\">Gotas de lebre bebê</span></a></li>\n</ul>\n</li>\n</ul>\n</div>\n\n<p><span id=\"Spawning\"></span>\n</p>\n<h2><span class=\"mw-headline\" id=\"Desova\">Desova</span></h2>\n<table class=\"wikitable\">\n<caption>Condições de desova\n</caption>\n<tbody><tr>\n<th>Animal</th>\n<th>Faixa de temperaturas</th>\n<th>Faixa de chuva</th>\n<th>Nível máximo de luz\n</th></tr>\n<tr>\n<td>Lebre do deserto</td>\n<td>22°C para 40°C</td>\n<td>0.20 para 0.45</td>\n<td>8\n</td></tr>\n<tr>\n<td>Lebre normal</td>\n<td>-5°C para 25°C</td>\n<td>0.30 para 0.90</td>\n<td>6\n</td></tr>\n<tr>\n<td>Lebre do Ártico</td>\n<td>-70°C para -8°C</td>\n<td>0.25 para 1.00</td>\n<td>8\n</td></tr></tbody></table>\n<p>As lebres aparecem em blocos <a href=\"/Special:MyLanguage/Grass\" title=\"Special:MyLanguage/Grass\">grama alta</a><span style=\"display:none\"><a href=\"/Grass\" title=\"Grass\"> </a></span> (incluindo versões \"muito curtas\" e \"comidas\") crescendo em <a href=\"/Special:MyLanguage/Soil\" title=\"Special:MyLanguage/Soil\">blocos de solo</a><span style=\"display:none\"><a href=\"/Soil\" title=\"Soil\"> </a></span> sólidos e não cultivados. As lebres não aparecerão em blocos iluminados. Uma maneira fácil de evitar a desova de lebres é colocar <a href=\"/Special:MyLanguage/Rock\" title=\"Special:MyLanguage/Rock\">rochas</a><span style=\"display:none\"><a href=\"/Rock\" title=\"Rock\"> </a></span> em blocos de solo para que a grama alta não cresça. Eles aparecem em grupos de 1 a 4 indivíduos.\n</p><p><span id=\"Behavior\"></span>\n</p>\n<h2><span class=\"mw-headline\" id=\"Comportamento\">Comportamento</span></h2>\n<p>As lebres procuram vegetais e grãos para comer que o jogador deixou cair no chão ou está cultivando como <a href=\"/Special:MyLanguage/Farming\" title=\"Special:MyLanguage/Farming\">plantações</a><span style=\"display:none\"><a href=\"/Farming\" title=\"Farming\"> </a></span> em solo arado (exceto <a href=\"/Special:MyLanguage/Pumpkin\" title=\"Special:MyLanguage/Pumpkin\">abóboras</a><span style=\"display:none\"><a href=\"/Pumpkin\" title=\"Pumpkin\"> </a></span> e <a href=\"/Special:MyLanguage/Onion\" title=\"Special:MyLanguage/Onion\">cebolas</a><span style=\"display:none\"><a href=\"/Onion\" title=\"Onion\"> </a></span>). Se uma lebre encontrar a fazenda de um jogador, ela comerá as colheitas em crescimento, independentemente do estágio de crescimento da colheita. Quando consumida, a colheita morrerá e deixará para trás uma planta seca da qual o jogador pode quebrar e recuperar uma semente. As lebres não procurarão nem destruirão colheitas silvestres.\n</p><p>As lebres sempre fogem de jogadores e outros criaturas em um raio de 12 quarteirões, mesmo antes de receberem dano.\nAs lebres adultas podem pular até um quarteirão de altura, o que significa que as lebres não podem pular cercas ou sair de buracos com 2 quarteirões de profundidade. No entanto, as lebres podem saltar cercas delimitadas por blocos de água devido ao aumento extra de altura ao saltar para fora da água.\n</p><p><span id=\"Domestication&#95;and&#95;Breeding\"></span>\n</p>\n<h2><span id=\"Domestica.C3.A7.C3.A3o_e_Reprodu.C3.A7.C3.A3o\"></span><span class=\"mw-headline\" id=\"Domesticação_e_Reprodução\">Domesticação e Reprodução</span></h2>\n<p>As lebres podem ser domesticadas através de <a href=\"/Special:MyLanguage/Animal_husbandry\" title=\"Special:MyLanguage/Animal husbandry\">criação</a><span style=\"display:none\"><a href=\"/Animal_husbandry\" title=\"Animal husbandry\"> </a></span>. Eles podem ser presos com <a href=\"/Special:MyLanguage/Reed_basket_trap\" title=\"Special:MyLanguage/Reed basket trap\">armadilhas de cesta de juncos</a><span style=\"display:none\"><a href=\"/Reed_basket_trap\" title=\"Reed basket trap\"> </a></span> ou perseguidos em um recinto cercado ou com 2 quarteirões de altura.\n</p><p>As lebres podem ser alimentadas jogando comida comestível no chão ou colocando-a em um <a href=\"/Special:MyLanguage/Trough\" title=\"Special:MyLanguage/Trough\">cocho pequeno</a><span style=\"display:none\"><a href=\"/Trough\" title=\"Trough\"> </a></span>. Uma fêmea precisará comer 2 porções antes de poder procriar. Se um macho estiver por perto, a fêmea engravidará com um período de gestação de 5 dias antes de dar à luz uma ninhada de 1 a 4 lebretes. Após o parto, a fêmea entrará em um período de espera antes de poder procriar novamente. Os alavancas chegam à idade adulta após 336 horas, ou 14 dias.\n</p><p>A partir da 3ª geração, o jogador pode matar lebres instantaneamente com um <a href=\"/Special:MyLanguage/Cleaver\" title=\"Special:MyLanguage/Cleaver\">cutelo</a><span style=\"display:none\"><a href=\"/Cleaver\" title=\"Cleaver\"> </a></span>. As lebres perderão o medo do jogador após 10 gerações.\n</p><p><span id=\"Food\"></span>\n</p>\n<h3><span class=\"mw-headline\" id=\"Comida\">Comida</span></h3>\n<table class=\"wikitable\">\n\n<tbody><tr>\n<th></th>\n<th>Nome do item\n</th></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Vegetable-cabbage.png\" class=\"mw-file-description\"><img src=\"/images/thumb/8/82/Vegetable-cabbage.png/32px-Vegetable-cabbage.png\" decoding=\"async\" loading=\"lazy\" width=\"32\" height=\"32\" class=\"mw-file-element\" srcset=\"/images/thumb/8/82/Vegetable-cabbage.png/48px-Vegetable-cabbage.png 1.5x, /images/thumb/8/82/Vegetable-cabbage.png/64px-Vegetable-cabbage.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span></td>\n<td><a href=\"/Special:MyLanguage/Cabbage\" title=\"Special:MyLanguage/Cabbage\">Repolho</a><span style=\"display:none\"><a href=\"/Cabbage\" title=\"Cabbage\"> </a></span>\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Carrot.png\" class=\"mw-file-description\"><img src=\"/images/thumb/c/c3/Carrot.png/32px-Carrot.png\" decoding=\"async\" loading=\"lazy\" width=\"32\" height=\"32\" class=\"mw-file-element\" srcset=\"/images/thumb/c/c3/Carrot.png/48px-Carrot.png 1.5x, /images/thumb/c/c3/Carrot.png/64px-Carrot.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span></td>\n<td><a href=\"/Special:MyLanguage/Carrot\" title=\"Special:MyLanguage/Carrot\">Cenoura</a><span style=\"display:none\"><a href=\"/Carrot\" title=\"Carrot\"> </a></span>\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Grid_onion.png\" class=\"mw-file-description\"><img src=\"/images/thumb/d/da/Grid_onion.png/32px-Grid_onion.png\" decoding=\"async\" loading=\"lazy\" width=\"32\" height=\"32\" class=\"mw-file-element\" srcset=\"/images/thumb/d/da/Grid_onion.png/48px-Grid_onion.png 1.5x, /images/thumb/d/da/Grid_onion.png/64px-Grid_onion.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span></td>\n<td><a href=\"/Special:MyLanguage/Onion\" title=\"Special:MyLanguage/Onion\">Cebola</a><span style=\"display:none\"><a href=\"/Onion\" title=\"Onion\"> </a></span>\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Vegetable-parsnip.png\" class=\"mw-file-description\"><img src=\"/images/thumb/e/e4/Vegetable-parsnip.png/32px-Vegetable-parsnip.png\" decoding=\"async\" loading=\"lazy\" width=\"32\" height=\"32\" class=\"mw-file-element\" srcset=\"/images/thumb/e/e4/Vegetable-parsnip.png/48px-Vegetable-parsnip.png 1.5x, /images/thumb/e/e4/Vegetable-parsnip.png/64px-Vegetable-parsnip.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span></td>\n<td><a href=\"/Special:MyLanguage/Parsnip\" title=\"Special:MyLanguage/Parsnip\">Chirívia</a><span style=\"display:none\"><a href=\"/Parsnip\" title=\"Parsnip\"> </a></span>\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Legume-peanut.png\" class=\"mw-file-description\"><img src=\"/images/thumb/6/6a/Legume-peanut.png/32px-Legume-peanut.png\" decoding=\"async\" loading=\"lazy\" width=\"32\" height=\"32\" class=\"mw-file-element\" srcset=\"/images/thumb/6/6a/Legume-peanut.png/48px-Legume-peanut.png 1.5x, /images/thumb/6/6a/Legume-peanut.png/64px-Legume-peanut.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span></td>\n<td><a href=\"/Special:MyLanguage/Peanut\" title=\"Special:MyLanguage/Peanut\">Amendoim</a><span style=\"display:none\"><a href=\"/Peanut\" title=\"Peanut\"> </a></span>\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Pumpkin-fruit-4.png\" class=\"mw-file-description\"><img src=\"/images/thumb/2/22/Pumpkin-fruit-4.png/32px-Pumpkin-fruit-4.png\" decoding=\"async\" loading=\"lazy\" width=\"32\" height=\"32\" class=\"mw-file-element\" srcset=\"/images/thumb/2/22/Pumpkin-fruit-4.png/48px-Pumpkin-fruit-4.png 1.5x, /images/thumb/2/22/Pumpkin-fruit-4.png/64px-Pumpkin-fruit-4.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span></td>\n<td><a href=\"/Special:MyLanguage/Pumpkin\" title=\"Special:MyLanguage/Pumpkin\">Abóbora</a><span style=\"display:none\"><a href=\"/Pumpkin\" title=\"Pumpkin\"> </a></span>\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Legume-soybean.png\" class=\"mw-file-description\"><img src=\"/images/thumb/d/d7/Legume-soybean.png/32px-Legume-soybean.png\" decoding=\"async\" loading=\"lazy\" width=\"32\" height=\"32\" class=\"mw-file-element\" srcset=\"/images/thumb/d/d7/Legume-soybean.png/48px-Legume-soybean.png 1.5x, /images/thumb/d/d7/Legume-soybean.png/64px-Legume-soybean.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span></td>\n<td><a href=\"/Special:MyLanguage/Soybean\" title=\"Special:MyLanguage/Soybean\">soja</a><span style=\"display:none\"><a href=\"/Soybean\" title=\"Soybean\"> </a></span>\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Vegetable-turnip.png\" class=\"mw-file-description\"><img src=\"/images/thumb/b/b7/Vegetable-turnip.png/32px-Vegetable-turnip.png\" decoding=\"async\" loading=\"lazy\" width=\"32\" height=\"32\" class=\"mw-file-element\" srcset=\"/images/thumb/b/b7/Vegetable-turnip.png/48px-Vegetable-turnip.png 1.5x, /images/thumb/b/b7/Vegetable-turnip.png/64px-Vegetable-turnip.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span></td>\n<td><a href=\"/Special:MyLanguage/Turnip\" title=\"Special:MyLanguage/Turnip\">Nabo</a><span style=\"display:none\"><a href=\"/Turnip\" title=\"Turnip\"> </a></span>\n</td></tr>\n<tr>\n<td><span typeof=\"mw:File\"><a href=\"/File:Pressedmash-cranberry.png\" class=\"mw-file-description\"><img src=\"/images/thumb/9/97/Pressedmash-cranberry.png/32px-Pressedmash-cranberry.png\" decoding=\"async\" loading=\"lazy\" width=\"32\" height=\"32\" class=\"mw-file-element\" srcset=\"/images/thumb/9/97/Pressedmash-cranberry.png/48px-Pressedmash-cranberry.png 1.5x, /images/thumb/9/97/Pressedmash-cranberry.png/64px-Pressedmash-cranberry.png 2x\" data-file-width=\"400\" data-file-height=\"400\" /></a></span></td>\n<td><a href=\"/Special:MyLanguage/Fruitpress\" title=\"Special:MyLanguage/Fruitpress\">Dry fruit mash</a><span style=\"display:none\"><a href=\"/Fruitpress\" title=\"Fruitpress\"> </a></span>\n</td></tr></tbody></table>\n<p><span id=\"Drops\"></span>\n</p>\n<h2><span class=\"mw-headline\" id=\"Itens_obtidos\">Itens obtidos</span></h2>\n<p><abbr t